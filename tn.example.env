# Environment for `tn-server serve` / `normalize` (copy to .env or export).
# Command-line options take precedence over these variables.

# Bind address and port of the HTTP API
TN_HOST=127.0.0.1
TN_PORT=8090
# Pronunciation lexicon (TSV), reloaded when it changes
TN_LEXICON=lexicon.example.tsv
# Log level
RUST_LOG=info
